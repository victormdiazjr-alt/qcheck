# ============================================================
# QCheck — variables de entorno
#
# HOY ESTE ARCHIVO ESTÁ VACÍO A PROPÓSITO.
#
# QCheck no tiene servidor: es HTML, CSS y JavaScript planos que
# corren en el navegador y guardan en localStorage. No hay proceso
# de build que sustituya variables, no hay secretos, y las dos APIs
# que usa —el NWS de San Juan y Open-Meteo, para el tiempo— son
# públicas y no piden llave.
#
# Cualquier valor que pusieras aquí acabaría en el JavaScript que
# se descarga el navegador, o sea a la vista de todos. Si algún día
# hace falta una llave de verdad, tiene que vivir en el backend
# (tarea Q-02), nunca aquí.
#
# Lo de abajo son las variables que ESE backend necesitará. Están
# comentadas porque todavía no existe nada que las lea.
# ============================================================

# --- Servidor local de desarrollo -------------------------------
# El único ajuste real hoy. `node serve.js 8452`
# PORT=8452

# ============================================================
# A PARTIR DE AQUÍ, NADA ESTÁ IMPLEMENTADO (ver TODO.md)
# ============================================================

# --- Q-02 · Backend y base de datos -----------------------------
# DATABASE_URL=postgres://usuario:clave@host:5432/qcheck
# API_BASE_URL=https://api.qcheck.example
# API_TOKEN=

# --- Q-07 · Autenticación real ----------------------------------
# Sustituye las cuentas de demostración de assets/usuarios.js,
# donde hoy las claves están escritas en el código.
# AUTH_JWT_SECRET=
# AUTH_SESSION_TTL=8h

# --- Q-04 · Correo al rechazar un camión ------------------------
# Hoy notifyReject() solo abre un correo pre-llenado.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=qc@segarraengineering.example

# --- Q-01 · OCR del conduce en papel ----------------------------
# OCR_PROVIDER=
# OCR_API_KEY=

# --- Q-06 · Adjuntos (fotos de conduce, losas, cilindros) -------
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Tiempo -----------------------------------------------------
# No hace falta llave: el NWS y Open-Meteo son abiertos.
# Las coordenadas del tiro NO van aquí: viven en el proyecto
# (db.project.lat / lon), editables en Plan & Datos.
